# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API. Until these are set, the public site serves the bundled
# seed menu (src/data/menu.ts) and the /admin panel shows a "configure" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — used for seeding and privileged server operations.
# NEVER expose to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Feature flags ────────────────────────────────────────────────────────────
# In-house online ordering (Phase 3). Set "true" to enable /order (requires Stripe below).
NEXT_PUBLIC_FEATURE_ORDERING=false
# Later phases — keep "false" for now (see docs/SYSTEM_ARCHITECTURE.md).
NEXT_PUBLIC_FEATURE_RESERVATIONS_V2=false
# Loyalty & rewards (Phase 5): "true" enables earning, the /account/rewards page,
# birthday rewards, and the admin loyalty panel. Schedule GET /api/cron/loyalty daily.
NEXT_PUBLIC_FEATURE_LOYALTY=false
# CRM & email marketing (Phase 6): "true" enables segments, campaigns, the
# /newsletter signup, abandoned-cart emails, and the admin Marketing area.
# Schedule GET /api/cron/marketing a few times a day (segments + abandoned cart).
# Uses the same Brevo/EMAIL_* config as transactional email (console fallback).
NEXT_PUBLIC_FEATURE_MARKETING=false

# ─── Admin panel (Phase 1) ────────────────────────────────────────────────────
# The /admin panel reuses the three Supabase vars above; no extra vars are needed.
# Sign-in uses Supabase Auth: create a user, then grant a staff role with
# supabase/grant_admin.sql. SUPABASE_SERVICE_ROLE_KEY must be set in production.

# ─── Reservations & email (Phase 2) ───────────────────────────────────────────
# Public origin, used to build "manage booking" links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Transactional email. With no key set, emails are logged to the server console
# (dev-friendly) instead of sent. Set EMAIL_PROVIDER=console to force that.
EMAIL_PROVIDER=
BREVO_API_KEY=
# Sender domain must be authenticated in Brevo (DKIM/SPF), or every send is rejected.
EMAIL_FROM_ADDRESS=reservations@bombaybicyclechef.com
EMAIL_FROM_NAME=Bombay Bicycle Chef
# Real mailbox for guest replies — the Brevo sender address may not receive mail.
EMAIL_REPLY_TO=
# Where new-booking alerts are sent (a real, monitored mailbox).
ADMIN_NOTIFY_EMAIL=
# Shared secret protecting GET /api/cron/reservations (reminders + outbox).
# Point Vercel Cron (or any scheduler) at that route with this secret. Unset = endpoint disabled.
CRON_SECRET=

# ─── Ordering & payments (Phase 3) ────────────────────────────────────────────
# Stripe hosted Checkout. Card data never touches us (PCI SAQ A). Required when
# NEXT_PUBLIC_FEATURE_ORDERING=true.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (Stripe Dashboard →
# Developers → Webhooks → the checkout.session.completed endpoint).
STRIPE_WEBHOOK_SECRET=

# ─── SMS & WhatsApp messaging (Phase 11) ──────────────────────────────────────
# Consent-gated SMS/WhatsApp. With none of these set, messages log to the console
# (dev). Schedule GET /api/cron/messaging?secret=$CRON_SECRET every ~15 min.
# Twilio (SMS, and optionally WhatsApp via Twilio). Auth token also verifies the
# /api/webhooks/twilio status + inbound (STOP/START) callbacks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=          # e.g. +447700900000
TWILIO_WHATSAPP_FROM=     # e.g. +14155238886 (Twilio WhatsApp sender), optional
# WhatsApp Cloud API (Meta) — preferred for WhatsApp when set; falls back to Twilio.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=

# ─── AI Business Intelligence (Phase 12) ──────────────────────────────────────
# /admin/insights is fully functional without these — every metric, forecast and
# recommendation is computed deterministically. The key only adds an LLM-written
# narrative on top of the supplied figures; with no key, a templated summary is
# used. The model is instructed never to invent numbers.
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-sonnet-4-6
# AI narration is OFF unless this is "on" (deterministic brief otherwise).
INSIGHTS_AI=

# ─── Multi-tenant SaaS platform (Phase 13) ────────────────────────────────────
# The platform (/platform) works without Stripe — tenants run on "manual" plans.
# To enable self-serve subscriptions, set the plan price IDs (Stripe Dashboard →
# Products) and a dedicated billing webhook secret pointed at
# /api/webhooks/stripe-billing. Reuses STRIPE_SECRET_KEY from Phase 3.
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Rate limiting (Upstash Redis REST). REQUIRED in production: checkout, gift-card
# checks, admin/customer login, registration, gift purchase and reservations FAIL
# CLOSED (reject requests) when these are unset in production, because the
# per-instance in-memory fallback is not safe across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
